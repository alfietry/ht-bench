# .gitignore for LLM Hypothesis Testing Benchmark

# Environment variables
.env

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter Notebook
.ipynb_checkpoints

# Data and results (optional - uncomment if you want to exclude)
# data/*
# results/*
# logs/*

# Keep directory structure
!data/.gitkeep
!results/.gitkeep
!logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# Test outputs
*.log
test_*.json

# Distribution / packaging
dist/
build/
*.egg-info/# Environment and secrets
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Results (optional - remove if you want to include sample results)
# results/*.json

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Build
dist/
build/
*.egg-info/
